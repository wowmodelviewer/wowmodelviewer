  <table name="ChrCustomizationReq">
    <!-- ID is noninline (id-list), so record fields start at index 0. Positions are
         the layout CA154412 (12.0.7 and 12.1.0): ReqType 1, ClassMask 2, RegionGroupMask 3,
         ReqAchievementID 4, ReqQuestID 5, OverrideArchive 6, ReqItemModifiedAppearanceID 7,
         RaceMasks 8. The old 12.0.5 (216BEF26) positions (RaceMask=0, ClassMask=3) read
         a string offset as RaceMask -> garbage race-gating -> wrong customization choices. -->
    <field type="int32" name="ID" primary="yes" />
    <field type="int32" name="ReqType" pos="1" />
    <field type="int32" name="ClassMask" pos="2" />
    <field type="int32" name="RegionGroupMask" pos="3" />
    <!-- Unlock gates (CA154412 record positions): a choice with any of these set is a
         conditional/collectible appearance the account must earn (achievement, quest, or
         a transmog item appearance). The in-game creator hides those by default, so we use
         them to drop "borrowed" entries instead of guessing from the race mask. -->
    <field type="int32" name="ReqAchievementID" pos="4" />
    <field type="int32" name="ReqQuestID" pos="5" />
    <field type="int32" name="OverrideArchive" pos="6" />
    <field type="int32" name="ReqItemModifiedAppearanceID" pos="7" />
    <!-- RaceMasks is two uint32 in the file (a pallet array of 2): RaceMasks1 is the low and
         RaceMasks2 the high half of the 64-bit race mask, indexed by ChrRaces.PlayableRaceBit. -->
    <field type="uint32" name="RaceMasks" arraySize="2" pos="8" absentValue="4294967295" />
  </table>
  <!-- A requirement's prerequisite choices: the requirement holds only while one of them is the
       current choice of its option. No field definition exists for this table in the bundled set;
       the relationship value is always a ChrCustomizationReq ID and the one record field always a
       ChrCustomizationChoice ID (every row of 12.1.0 resolves both ways). -->
  <table name="ChrCustomizationReqChoice" layoutHash="0xF925BC6F">
    <field type="int32" name="ID" primary="yes" />
    <field type="int32" name="ChrCustomizationChoiceID" pos="0" />
    <field type="int32" name="ChrCustomizationReqID" relationshipData="yes" />
  </table>
