  <!-- A humanoid NPC's stored customization: one row per option, naming the choice the NPC shows. The ID is not inline;
       field 0 is the ChrCustomizationOption, field 1 the ChrCustomizationChoice, and the relationship value the
       CreatureDisplayInfoExtra. No definition ships for this table; its layout is the same in Retail 12.1, MoP Classic
       5.5.4, Classic Beta 1.60.1 and Classic Era 1.15.9, so layoutHash verifies the positions for each of them. -->
  <table name="CreatureDisplayInfoOption" layoutHash="0x2F331C33">
    <field type="int32" name="ID" primary="yes" />
    <field type="int32" name="ChrCustomizationOptionID" pos="0" />
    <field type="int32" name="ChrCustomizationChoiceID" pos="1" />
    <field type="int32" name="CreatureDisplayInfoExtraID" relationshipData="yes" />
  </table>
  <!-- Classic Beta 1.60.1: a character model's other generation. ChrModelAltVariant pairs a playable ChrModel (one with a
       ChrRaceXChrModel row) with the alternate ChrModel of the same race and sex, which no ChrRaceXChrModel row names;
       ChrModelAltVariantOption pairs their options, ChrModelAltVariantChoice those options' choices (one to one). No
       definition ships for these tables. The ID is inline in field 0 (the files carry no ID list); the other columns
       were identified by their references: every primary a playable ChrModel and every alternate one without a race
       row, every option pair an option of each model, every choice pair a choice of each option (18, 93 and 1,136
       rows, all consistent). layoutHash verifies the positions; RaceInfos checks every row again as it reads them. -->
  <table name="ChrModelAltVariant" layoutHash="0x3562BFF9">
    <field type="int32" name="ID" primary="yes" pos="0" />
    <field type="int32" name="PrimaryChrModelID" pos="1" />
