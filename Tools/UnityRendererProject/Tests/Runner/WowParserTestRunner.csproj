<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Console runner for the framework-free parser tests (WowParserTests, WorldParserTests), the terrain
    mesh and material tests (TerrainMeshTests, TerrainMaterialTests), the real-corpus validation
    (WorldCorpusValidation, TerrainCorpusTests and TerrainMaterialCorpusTests, run only when
    WMV_WORLD_AUDIT_CORPUS names the extracted audit data; TerrainCorpusTests also writes mesh dumps when
    WMV_TERRAIN_DUMP_DIR is set), and the world-map contract check (MapContractCheck, only when
    WMV_MAP_CONTRACT_DIR names a folder of WDTs the viewer wrote). Compiles the Unity project's pure
    parsing layer (Assets/Scripts/Wow) as plain C#; it is not part of the Unity project or the viewer build.

      dotnet run, Release configuration, with this project file (see Tests/README.md)
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\Assets\Scripts\Wow\**\*.cs" />
    <Compile Include="..\WowParserTests.cs" />
    <Compile Include="..\WorldParserTests.cs" />
    <Compile Include="..\TerrainMeshTests.cs" />
    <Compile Include="..\TerrainCorpusTests.cs" />
    <Compile Include="..\TerrainMaterialTests.cs" />
    <Compile Include="..\TerrainMaterialCorpusTests.cs" />
    <Compile Include="..\WorldCorpusValidation.cs" />
    <Compile Include="..\MapContractCheck.cs" />
    <Compile Include="..\WorldModelTests.cs" />
    <Compile Include="..\WorldModelCorpusTests.cs" />
    <Compile Include="..\DoodadTests.cs" />
    <Compile Include="..\DoodadCorpusTests.cs" />
    <Compile Include="..\BlpBlockTests.cs" />
    <Compile Include="..\StreamSeamTests.cs" />
    <Compile Include="..\LiquidTests.cs" />
    <Compile Include="..\LiquidCorpusTests.cs" />
    <Compile Include="..\LiquidLightTests.cs" />
    <Compile Include="..\LiquidHighTests.cs" />
    <Compile Include="..\WorldLightTests.cs" />
    <Compile Include="..\SkyTerrainLightTests.cs" />
    <Compile Include="..\WorldModelLightTests.cs" />
    <Compile Include="..\WorldFogTests.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>
</Project>
