# Writes a SPIR-V binary as a C++ header holding a uint32_t array: cmake -DIN=<spv> -DOUT=<header> -DNAME=<symbol>
file(READ "${IN}" hex HEX)
string(LENGTH "${hex}" len)
math(EXPR words "${len} / 8")
set(body "")
set(i 0)
while(i LESS len)
  # SPIR-V words are little-endian in the file
  string(SUBSTRING "${hex}" ${i} 8 w)
  string(SUBSTRING "${w}" 6 2 b3)
  string(SUBSTRING "${w}" 4 2 b2)
  string(SUBSTRING "${w}" 2 2 b1)
  string(SUBSTRING "${w}" 0 2 b0)
  string(APPEND body "0x${b3}${b2}${b1}${b0},")
  math(EXPR i "${i} + 8")
  math(EXPR col "(${i} / 8) % 8")
  if(col EQUAL 0)
    string(APPEND body "\n")
  endif()
endwhile()
file(WRITE "${OUT}" "// Generated from ${IN}; do not edit.\n#pragma once\n#include <cstdint>\nstatic const uint32_t ${NAME}[] = {\n${body}\n};\n")
